            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifactref"
        },
        "apiMethod": {
          "anyOf": [
            {
              "enum": [
                "GET",
                "POST",
                "PUT",
                "PATCH",
                "DELETE"
