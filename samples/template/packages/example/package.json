{
  "packageId": "example-interaction",
  "version": "1.0.0",
  "name": "标准模型交互包",
  "description": "由实例配置指令，一次调用返回 text",
  "entry": "entry:invoke",
  "contractRefs": {
    "input": "models:Message",
    "output": "models:Message",
    "configuration": "models:Config"
  },
  "runtimeRequirements": {
    "python": ">=3.12",
    "platformApi": 1,
    "dependencies": [
      "pydantic>=2.10,<3"
    ]
  },
  "requiredCapabilities": [
    {
      "capabilityId": "chat",
      "kind": "model",
      "inputModel": "models:ModelRequest",
      "outputModel": "models:ModelResponse"
    }
  ],
  "budgetDefaults": {
    "loopLimit": 1,
    "tokenLimit": 32768
  }
}
