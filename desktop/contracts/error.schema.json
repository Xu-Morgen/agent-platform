      "title": "Code",
      "type": "string"
    },
    "stage": {
      "title": "Stage",
      "type": "string"
    },
    "message": {
      "title": "Message",
      "type": "string"
    },
    "runId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Runid"
