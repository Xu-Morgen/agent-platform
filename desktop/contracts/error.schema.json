    "fieldPath": {
      "anyOf": [
        {
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ]
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fieldpath"
    },
    "details": {
      "$ref": "#/$defs/ErrorDetails"
    }
  },
  "required": [
    "code",
    "stage",
    "message"
  ],
  "title": "ErrorResponse",
  "type": "object"
}
