{
  "$defs": {
    "ErrorDetails": {
      "additionalProperties": false,
      "description": "仅允许已知非敏感元数据，不能附带任意上游字典。",
      "properties": {
        "runStatus": {
          "anyOf": [
            {
              "enum": [
                "queued",
                "running",
                "completed",
                "failed",
                "cancelled"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Runstatus"
        },
        "packageBindingId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Packagebindingid"
        },
        "attempt": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attempt"
        },
        "activeRunIds": {
          "items": {
            "type": "string"
          },
          "title": "Activerunids",
          "type": "array"
        },
        "timeoutSeconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeoutseconds"
        },
        "httpStatus": {
          "anyOf": [
            {
              "maximum": 599,
              "minimum": 100,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Httpstatus"
        }
      },
      "title": "ErrorDetails",
      "type": "object"
    },
    "ValidationIssue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "default": "CONTRACT_VALIDATION_ERROR",
          "title": "Code",
          "type": "string"
        },
        "stage": {
          "default": "flow.validation",
          "title": "Stage",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "reasonType": {
          "default": "constraint",
          "title": "Reasontype",
          "type": "string"
        },
        "expected": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected"
        },
        "fieldPath": {
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ]
          },
          "title": "Fieldpath",
          "type": "array"
        },
        "nodeId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Nodeid"
        },
        "sourceNodeId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sourcenodeid"
        }
      },
      "required": [
        "reason"
      ],
      "title": "ValidationIssue",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "code": {
      "enum": [
        "DOCUMENT_READ_ERROR",
        "DOCUMENT_LIMIT_EXCEEDED",
        "PACKAGE_INPUT_INSUFFICIENT",
        "MODEL_CONTEXT_EXCEEDED",
        "PREPARATION_CANCELLED",
        "PREPARATION_TIMEOUT",
        "PREPARATION_URL_ERROR",
        "PREPARATION_NETWORK_ERROR",
        "PREPARATION_HASH_MISMATCH",
        "PREPARATION_DISK_FULL",
        "DEPENDENCY_CONFLICT",
        "DEPENDENCY_WHEEL_UNAVAILABLE",
        "BLOCK_TIMEOUT",
        "BLOCK_PROCESS_ERROR",
        "FILE_NOT_FOUND",
        "FILE_REFERENCE_INVALID",
        "FILE_FORMAT_UNSUPPORTED",
        "FILE_TOO_LARGE",
        "FILE_SAVE_FAILED",
        "LOOP_ITERATION_LIMIT",
        "RUN_CANCELLED",
        "GRAPH_EXECUTION_LIMIT",
        "RESULT_NOT_READY",
        "CONFIGURATION_ERROR",
        "CONTRACT_VALIDATION_ERROR",
        "DEPENDENCY_ERROR",
        "ENVIRONMENT_IN_USE",
        "LOOP_BUDGET_EXCEEDED",
        "TOKEN_BUDGET_EXCEEDED",
        "TOKEN_ACCOUNTING_UNSUPPORTED",
        "MODEL_TIMEOUT",
        "MODEL_TRANSPORT_ERROR",
        "API_TIMEOUT",
        "API_TRANSPORT_ERROR",
        "OUTPUT_VALIDATION_ERROR",
        "RECORD_NOT_FOUND",
        "VERSION_CONFLICT",
        "INTERNAL_ERROR",
        "HTTP_ERROR",
        "BACKEND_UNAVAILABLE",
        "STARTUP_ERROR",
        "APPLICATION_EXIT",
        "APPLICATION_INTERRUPTED",
        "STORAGE_ERROR"
      ],
      "title": "Code",
      "type": "string"
    },
    "stage": {
      "title": "Stage",
      "type": "string"
    },
    "message": {
      "title": "Message",
      "type": "string"
    },
    "runId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Runid"
    },
    "fieldPath": {
      "anyOf": [
        {
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ]
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fieldpath"
    },
    "nodeId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Nodeid"
    },
    "sourceNodeId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sourcenodeid"
    },
    "issues": {
      "items": {
        "$ref": "#/$defs/ValidationIssue"
      },
      "title": "Issues",
      "type": "array"
    },
    "details": {
      "$ref": "#/$defs/ErrorDetails"
    }
  },
  "required": [
    "code",
    "stage",
    "message"
  ],
  "title": "ErrorResponse",
  "type": "object"
}
