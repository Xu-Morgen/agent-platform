{
  "$defs": {
    "ErrorDetails": {
      "additionalProperties": false,
      "description": "仅允许已知非敏感元数据，不能附带任意上游字典。",
      "properties": {
        "runStatus": {
          "anyOf": [
            {
              "enum": [
                "queued",
                "running",
                "completed",
                "failed",
                "cancelled"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Runstatus"
        },
        "packageBindingId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Packagebindingid"
        },
        "attempt": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attempt"
        },
        "upstreamCode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upstreamcode"
        },
        "upstreamMsg": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upstreammsg"
        },
        "upstreamSubCode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upstreamsubcode"
        },
        "upstreamSubMsg": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upstreamsubmsg"
        },
        "activeRunIds": {
          "items": {
            "type": "string"
          },
          "title": "Activerunids",
          "type": "array"
        },
        "timeoutSeconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeoutseconds"
        },
        "httpStatus": {
          "anyOf": [
            {
              "maximum": 599,
              "minimum": 100,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Httpstatus"
        }
      },
      "title": "ErrorDetails",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "code": {
      "enum": [
        "RUN_CANCELLED",
        "GRAPH_EXECUTION_LIMIT",
        "RESULT_NOT_READY",
        "UPSTREAM_BUSINESS_ERROR",
        "CONFIGURATION_ERROR",
        "CONTRACT_VALIDATION_ERROR",
        "DEPENDENCY_ERROR",
        "ENVIRONMENT_IN_USE",
        "LOOP_BUDGET_EXCEEDED",
        "TOKEN_BUDGET_EXCEEDED",
        "TOKEN_ACCOUNTING_UNSUPPORTED",
        "MODEL_TIMEOUT",
        "MODEL_TRANSPORT_ERROR",
        "API_TIMEOUT",
        "API_TRANSPORT_ERROR",
        "OUTPUT_VALIDATION_ERROR",
        "RECORD_NOT_FOUND",
        "VERSION_CONFLICT",
        "INTERNAL_ERROR",
        "HTTP_ERROR",
        "BACKEND_UNAVAILABLE",
        "STARTUP_ERROR",
        "APPLICATION_EXIT"
