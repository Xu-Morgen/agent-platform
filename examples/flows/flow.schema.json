          "items": {
            "discriminator": {
              "mapping": {
                "block": "#/$defs/ModuleNode",
                "if": "#/$defs/IfNode",
                "package": "#/$defs/ModuleNode",
                "repeat": "#/$defs/RepeatNode",
                "while": "#/$defs/WhileNode"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/ModuleNode"
              },
              {
                "$ref": "#/$defs/IfNode"
              },
              {
                "$ref": "#/$defs/RepeatNode"
              },
              {
                "$ref": "#/$defs/WhileNode"
              }
            ]
          },
          "title": "Nodes",
          "type": "array"
        },
        "output": {
          "items": {
            "$ref": "#/$defs/PortBinding"
          },
          "title": "Output",
          "type": "array"
        }
      },
      "required": [
        "output"
      ],
      "title": "Branch",
      "type": "object"
    },
    "CapabilitySelection": {
